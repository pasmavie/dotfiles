{
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(python3.12:*)",
      "Bash(PYTHONPATH=*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(find:*)",
      "Bash(xargs:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(env:*)",
      "Bash(kill:*)",
      "Bash(ls:*)",
      "Bash(chmod:*)",
      "Bash(tmux:*)",
      "Bash(brew:*)",
      "Bash(aws s3:*)",
      "Bash(aws sts:*)",
      "Bash(aws secretsmanager:*)",
      "Read(//Users/giovanni/**)",
      "Bash(pyenv version:*)",
      "Bash(claude mcp:*)",
      "Read(//tmp/**)"
    ]
  },
  "model": "opus[1m]",
  "disableClaudeAiConnectors": false,
  "skillOverrides": {
    "code-review": "user-invocable-only"
  },
  "deniedMcpServers": [
    {
      "serverName": "claude.ai Figma"
    },
    {
      "serverName": "claude.ai Granola"
    },
    {
      "serverName": "claude.ai HubSpot"
    },
    {
      "serverName": "claude.ai Microsoft 365"
    },
    {
      "serverName": "claude.ai Rocketlane"
    },
    {
      "serverName": "claude.ai Atlassian"
    }
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "grep -m1 '^RULE:' \"$HOME/.claude/rules/communication-style.md\" | sed 's/^RULE:/Communication-style rule (applies to this reply):/'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/notify.sh 'Claude Code' 'Awaiting input'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/notify.sh 'Claude Code' 'Task completed'"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "atlassian@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    }
  },
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "vim",
  "switchModelsOnFlag": true,
  "skipAutoPermissionPrompt": true
}
